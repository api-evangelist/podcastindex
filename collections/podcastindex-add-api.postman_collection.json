{
  "item": [
    {
      "id": "d5ceb97b-1cbb-456d-b8c7-43775387cbbf",
      "name": "Add",
      "description": {
        "content": "Add new podcast feeds to the index.\n\n\n**NOTE**: To add to the index, the API Key must have write or publisher permissions.\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "663088f5-a0e3-45a2-a167-4a89720fd605",
          "name": "By Feed URL",
          "request": {
            "name": "By Feed URL",
            "description": {
              "content": "This call adds a podcast to the index using its feed url. If a feed already exists, you will get its existing Feed ID returned.\n\n\n**NOTE**: this endpoint requires an API Key with the **write** permission.\n\n\nExample: https://api.podcastindex.org/api/1.0/add/byfeedurl?url=https://feeds.theincomparable.com/batmanuniversity&pretty\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "add",
                "byfeedurl"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "(Required) Podcast feed URL\n"
                },
                {
                  "disabled": false,
                  "key": "chash",
                  "value": "<string>",
                  "description": "(Required) The md5 hash of the following feed items in hex format.\nIf known, allows for easier duplicate checking.\n\n  - `title`\n  - `link`\n  - `feedLanguage`\n  - `generator`\n  - `author`\n  - `ownerName`\n  - `ownerEmail` (note: not exposed via the API)\n\nPseudo-code:\n\n      chash = md5(title+link+feedLanguage+generator+author+ownerName+ownerEmail)\n"
                },
                {
                  "disabled": false,
                  "key": "itunesid",
                  "value": "<integer>",
                  "description": "If this parameter is given, and the existing feed has no associated iTunes ID, it will be associated with this ID.\nIf an existing iTunes ID is already associated with this feed it will **NOT** be changed.\n"
                },
                {
                  "disabled": false,
                  "key": "pretty",
                  "value": "<boolean>",
                  "description": "If present, makes the output “pretty” to help with debugging.\n\n\nParameter shall not have a value\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Auth-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "140bad94-b10f-41a5-9703-bd8037431848",
              "name": "Success",
              "originalRequest": {
